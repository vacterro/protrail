# Build trees and generated output
build/
build_*/
out/
.cache/
.vs/
Testing/
artifacts/
dist/
.freebuff/

# Python byte-compiled cache
__pycache__/
*.pyc

# Local tooling state (editor/agent caches, never product sources)
.codebase-memory/
dev/presets/
*.user

# Local logs and scratch output captured at the repository root. These are
# per-run working files, not product sources: the canonical record of a ticket
# lives in .saipen/ and ROADMAP/evidence/.
*.log
/*.txt
!/CMakeLists.txt
/*.csv
/*_out.txt
/*_res.txt

# Local scripts, probes, packages and dumps at the repository root.
# (The handful of historical build/deploy scripts that ARE tracked stay
# tracked; this only stops NEW root-level scratch from being added.)
/*.bat
/*.ps1
/*.cmd
# protrail.cmd is the canonical single launcher, not scratch.
!/protrail.cmd
/*.tmp
/*.dmp
/*.zip
/*.rar

# SAIPEN runtime (per-run, never versioned)
.saipen/cache/
.saipen/locks/
.saipen/recovery/conformance/

# Personal sound catalog. ProTrail plays whatever the operator puts in a
# `sound` folder beside the executable; the repository never ships it. The
# names previously committed here were third-party game audio with no
# redistribution rights, so the folder is untracked from now on and each user
# supplies their own. See README "Sound" for the per-event file contract.
/sound/
